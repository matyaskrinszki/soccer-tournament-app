# This is an example .env file. Copy this file to .env.local and fill in the values for your local development environment.

# JWT_SECRET is used for signing and verifying JSON Web Tokens (JWTs) for authentication. 
# Make sure to keep this value secret and do not commit it to version control.
# The JWT_SECRET should have at least 32 random bytes (64 hex characters) for security purposes.
# You can generate a secure random string using this line in the terminal:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=